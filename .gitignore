# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build Outputs ---
dist/
build/
out/
coverage/

# --- Environment Variables (Global Root) ---
# Ігноруємо .env файли в корені, крім example
.env
.env.local
.env.*.local
!.env.example

# --- Environment Variables (Dotenv Folder) ---
# 1. Ігноруємо ВСЕ в папці dotenv (включно з підпапками prod, staging)
configs/dotenv/prod/.env.*

# 2. ЯВНО дозволяємо папку dev і її вміст (Це найважливіше!)
!configs/dotenv/dev/.env.*

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*

